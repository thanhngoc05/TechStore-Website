# Generate a private value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Trusted public site address used in password-reset emails (HTTPS in deployment).
PUBLIC_BASE_URL=http://127.0.0.1:5001

# SQLite for local development. Set USE_SQLITE=0 for MySQL.
USE_SQLITE=1
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nextech_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Optional initial administrator. All three values are required to create one.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Development email stays on this computer; no real email is sent.
EMAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=

# Optional online payment. Use public HTTPS URLs when configuring payOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

FLASK_DEBUG=0
PORT=5001
BIND_HOST=127.0.0.1
WSGI_THREADS=4
# Development convenience; use 0 for read-only deployment preflight.
DB_AUTO_INITIALIZE=1
RATE_LIMIT_ENABLED=1
